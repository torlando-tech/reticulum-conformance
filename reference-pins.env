# Audited reference releases the conformance suite certifies against.
#
# SINGLE SOURCE OF TRUTH for the RNS/LXMF pins. Every consumer reads this file
# instead of hardcoding a version:
#   * .github/workflows/tests.yml    — the Reticulum/LXMF checkouts + asserts
#   * .github/workflows/honesty.yml  — the PyPI install the catalog resolves
#   * tools/check_rns_lxmf_versions.py — the drift guard
#   * downstream SUT repos (reticulum-kt .github/workflows/{tests,conformance}.yml)
#
# Re-auditing is a one-line change here. Bump the values only after the full
# suite is green against the new pair (--impl=kotlin and --reference-only).
RNS=1.5.5
LXMF=1.2.0
